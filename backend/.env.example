# LLM proxy
# auto: 本地默认推荐；有 LLM_PROXY_URL 时使用它，否则兼容 HTTP_PROXY/HTTPS_PROXY/ALL_PROXY
# off: 模型调用完全忽略系统代理，适合服务器全局代理会干扰模型服务时
# env: 强制使用系统代理环境变量
# url: 只使用 LLM_PROXY_URL
LLM_PROXY_MODE=auto
# LLM_PROXY_URL=socks5://127.0.0.1:7897

# mcp
MCP_API_KEY=MAK_XC_123456

EXTERNAL_API_KEYS=["xc-rpa-1ba531fa-264d-4fa2-b57c-006442b46f5d"]
BACKEND_CORS_ORIGINS=["*"]

# 泛微流程 AI 助手：按 workflowid 配置字段白名单，ecode 会根据 workflowid 从平台读取。
# 字段 ID 仍来自泛微表单，例如 field1234；后续可替换为实时查询泛微字段元数据。
# WEAVER_AI_FIELD_CONFIGS={"494":[{"bizKey":"title","label":"标题","fieldId":"field1234","type":"text"},{"bizKey":"reason","label":"请假原因","fieldId":"field1237","type":"textarea"},{"bizKey":"startDate","label":"请假开始日期","fieldId":"field1238","type":"date"},{"bizKey":"endDate","label":"请假结束日期","fieldId":"field1239","type":"date"},{"bizKey":"days","label":"请假天数","fieldId":"field1240","type":"number"}]}

# 泛微 / Ecology MySQL8 多环境配置。
# ecode 通过 WEAVER_ENV 传入环境 key，例如 test、prod；不传则使用 WEAVER_DEFAULT_ENV。
# 账号建议使用只读账号，只查询流程、表单、字段、节点等元数据。
WEAVER_DEFAULT_ENV=test
WEAVER_DB_CONFIGS='{"test":{"host":"192.168.14.168","port":3306,"database":"ecology","user":"ecology","password":"Weaver@2023","charset":"utf8mb4"},"prod":{"host":"192.168.14.168","port":3306,"database":"ecology","user":"ecology","password":"Weaver@2023","charset":"utf8mb4"},"yuxin":{"host":"192.168.77.85","port":3306,"database":"ecology","user":"ecology","password":"Weaver@2026","charset":"utf8mb4"}}'

